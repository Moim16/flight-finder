# URL de contacto que va en el User-Agent. planespotters (fotos) rechaza las
# peticiones sin un contacto. La URL del repositorio sirve.
CONTACT_URL=https://github.com/Moim16/flight-finder

# OPCIONAL. Cuenta gratis de OpenSky (https://opensky-network.org -> Account ->
# API client). Sin esto se usa el acceso anonimo: 400 creditos al dia, que se
# gastan rapido. Con cuenta son 4000.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
